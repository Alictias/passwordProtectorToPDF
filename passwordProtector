import tkinter as tk
from tkinter import filedialog, simpledialog, messagebox
from pathlib import Path
import pikepdf

# Esconde a janela principal
root = tk.Tk()
root.withdraw()

# Selecionar arquivo
arquivo = filedialog.askopenfilename(
    title="Selecione um PDF",
    filetypes=[
        ("Documentos", "*.pdf"),
        ("PDF", "*.pdf")
    ]
)

if not arquivo:
    messagebox.showinfo("Cancelado", "Nenhum arquivo selecionado.")
    exit()

# Verifica se é PDF
if not arquivo.lower().endswith(".pdf"):
    messagebox.showerror(
        "Formato não suportado",
        "Atualmente apenas PDFs podem ser protegidos."
    )
    exit()

# Solicitar senha
senha = simpledialog.askstring(
    "Senha",
    "Digite a senha para abrir o PDF:",
    show="*"
)

if not senha:
    messagebox.showerror("Erro", "Nenhuma senha informada.")
    exit()

try:
    pdf = pikepdf.Pdf.open(arquivo)

    caminho_original = Path(arquivo)

    novo_arquivo = (
        caminho_original.parent
        / f"{caminho_original.stem}_protegido.pdf"
    )

    pdf.save(
        novo_arquivo,
        encryption=pikepdf.Encryption(
            user=senha,
            owner="senha_admin_super_secreta",
            allow=pikepdf.Permissions(
                print_lowres=False,
                print_highres=False,
                extract=False,
                modify_annotation=False,
                modify_other=False
            ),
        ),
    )

    messagebox.showinfo(
        "Sucesso",
        f"PDF protegido criado:\n{novo_arquivo}"
    )

except Exception as e:
    messagebox.showerror("Erro", str(e))