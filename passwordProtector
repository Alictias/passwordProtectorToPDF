import tkinter as tk
from tkinter import filedialog, simpledialog, messagebox
from pathlib import Path
import pikepdf

# Hide the main window
root = tk.Tk()
root.withdraw()

# Select file
file_path = filedialog.askopenfilename(
    title="Select a PDF",
    filetypes=[
        ("Documents", "*.pdf"),
        ("PDF", "*.pdf")
    ]
)

if not file_path:
    messagebox.showinfo("Cancelled", "No file selected.")
    exit()

# Check if it's a PDF
if not file_path.lower().endswith(".pdf"):
    messagebox.showerror(
        "Unsupported Format",
        "Currently only PDF files can be protected."
    )
    exit()

# Request password
password = simpledialog.askstring(
    "Password",
    "Enter the password to open the PDF:",
    show="*"
)

if not password:
    messagebox.showerror("Error", "No password provided.")
    exit()

try:
    pdf = pikepdf.Pdf.open(file_path)

    original_path = Path(file_path)

    output_file = (
        original_path.parent
        / f"{original_path.stem}_protected.pdf"
    )

    pdf.save(
        output_file,
        encryption=pikepdf.Encryption(
            user=password,
            #this owner serves to allow admin permissions, for now it's 
            owner="secret_password",
            allow=pikepdf.Permissions(
                print_lowres=False,
                print_highres=False,
                extract=False,
                modify_annotation=False,
                modify_other=False
            ),
        ),
    )

    messagebox.showinfo(
        "Success",
        f"Protected PDF created:\n{output_file}"
    )

except Exception as e:
    messagebox.showerror("Error", str(e))